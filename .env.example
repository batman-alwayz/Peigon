# For a separately hosted frontend, point this to your backend public URL.
# Leave blank when the Docker container serves both frontend and backend.
VITE_API_URL=https://your-backend.example.com

# Backend only: use your pooled Neon connection string. Never commit a real value.
DATABASE_URL=postgresql://user:password@your-host-pooler.neon.tech/neondb?sslmode=require

# Comma-separated allowed browser origins for a separately hosted frontend.
FRONTEND_URL=https://your-frontend.example.com
