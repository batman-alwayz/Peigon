# Leave blank when frontend and API are served from the same origin.
VITE_API_URL=

# Optional comma-separated browser origins for a separately hosted frontend.
# Same-origin requests work with this unset. Never use * for a public deployment.
FRONTEND_URL=

# Use a stable random value of at least 32 characters in production.
TICKET_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Enable only when the app is behind one trusted HTTPS reverse proxy (Render).
TRUST_PROXY=false

# Persistent local data directory. Docker Compose sets this automatically.
STORAGE_PATH=.
